# Django
DEBUG=0
SECRET_KEY=demo-clave-insegura-solo-para-desarrollo-cambiar
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (POSTGRES_HOST y POSTGRES_PORT los fija compose.yaml para el servicio web)
POSTGRES_DB=catalogo
POSTGRES_USER=catalogo
POSTGRES_PASSWORD=demo-password-cambiar
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cuentas de demostración (se usarán en la fase de cuentas; valores de DEMO)
DEMO_ADMIN_USUARIO=admin.demo
DEMO_ADMIN_CORREO=admin.demo@example.com
DEMO_ADMIN_NOMBRE=Administrador Demo
DEMO_ADMIN_PASSWORD=demo-Admin-cambiar-2026
DEMO_CONSULTA_USUARIO=consulta.demo
DEMO_CONSULTA_CORREO=consulta.demo@example.com
DEMO_CONSULTA_NOMBRE=Consulta Demo
